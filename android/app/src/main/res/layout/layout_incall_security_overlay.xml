<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="16dp"
    android:background="@drawable/bg_overlay_hud"
    android:elevation="16dp"
    android:orientation="vertical"
    android:padding="16dp">

    <!-- Header Row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/ivOverlayShield"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@drawable/ic_cyphex_shield" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvOverlayDirection"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:text="ACTIVE CALL DEFENSE"
                android:textColor="#00F0FF"
                android:textSize="10sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvOverlayPhoneNumber"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="+91 98201 44821"
                android:textColor="#F8FAFC"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/btnOverlayDismiss"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_close" />
    </LinearLayout>

    <!-- Risk & Biometric Gauge Row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:background="#1AFFFFFF"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="10dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:text="SYNTHETIC PROBABILITY"
                android:textColor="#94A3B8"
                android:textSize="9sp" />

            <TextView
                android:id="@+id/tvOverlayRiskScore"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:text="4%"
                android:textColor="#10B981"
                android:textSize="22sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvOverlayVerdict"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="#064E3B"
            android:fontFamily="monospace"
            android:paddingHorizontal="10dp"
            android:paddingVertical="5dp"
            android:text="BONA FIDE HUMAN"
            android:textColor="#A7F3D0"
            android:textSize="10sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Recommendation & Anomaly Flags -->
    <TextView
        android:id="@+id/tvOverlayRecommendation"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="ALLOW: Natural vocal tract resonance &amp; organic jitter verified."
        android:textColor="#CBD5E1"
        android:textSize="11sp" />

    <TextView
        android:id="@+id/tvOverlayAnomalyFlags"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:fontFamily="monospace"
        android:text="HF_VOCODER_ARTIFACT • ROBOTIC_FLATNESS"
        android:textColor="#FCA5A5"
        android:textSize="9sp"
        android:visibility="gone" />

</LinearLayout>

